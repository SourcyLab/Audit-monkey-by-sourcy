{
  "name": "audit-monkey-by-sourcy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite app --host 127.0.0.1",
    "build": "tsc --noEmit && vite build app",
    "preview": "vite preview app --host 127.0.0.1",
    "lint": "eslint app/src mcp backend/*.ts scripts/benchmark.ts tests && tsc --noEmit && tsc --noEmit -p backend/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/sync-brand.mjs && node scripts/sync-guides.mjs",
    "prebuild": "node scripts/sync-brand.mjs && node scripts/sync-guides.mjs",
    "mcp:stdio": "tsx mcp/server.ts",
    "mcp:http": "tsx mcp/server.ts --http",
    "test:browser": "node scripts/browser-check.mjs",
    "start": "npm ci && npm run build && node scripts/start-backend.mjs",
    "dev:api": "node scripts/start-backend.mjs",
    "build:api": "node scripts/build-backend.mjs",
    "pretest": "npm run build && npm run build:api",
    "test:pilot-browser": "node scripts/pilot-browser-check.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "miniflare": "^4.20260730.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "sharp": "^0.35.5",
    "undici": "^7.30.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
